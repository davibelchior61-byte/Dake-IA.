<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dake-IA</title>
<!-- Firebase Web SDK (v9 via CDN) -->
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
<style>
* { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
body { background-color: #1e1e2f; color: #fff; margin: 0; padding: 10px; display: flex; justify-content: center; }
.app-container { width: 100%; max-width: 800px; background: #2b2b3d; border-radius: 12px; padding: 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
h1, h2, h3 { text-align: center; color: #4da6ff; margin-top: 0; }
/* Navegação por Abas */
.tabs { display: flex; gap: 5px; margin-bottom: 15px; border-bottom: 2px solid #3f3f5a; padding-bottom: 10px; overflow-x: auto; }
.tab-btn { background: #3f3f5a; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; white-space: nowrap; }
.tab-btn.active { background: #4da6ff; font-weight: bold; }
.tab-content { display: none; }
.tab-content.active { display: block; }
/* Interface de Chat */
#chat-box { height: 350px; overflow-y: auto; background: #1e1e2f; padding: 15px; border-radius: 8px; border: 1px solid #3f3f5a; display: flex; flex-direction: column; gap: 10px; }
.message { padding: 10px 14px; border-radius: 8px; max-width: 80%; line-height: 1.4; word-wrap: break-word; }
.message.user { background: #4da6ff; color: #1e1e2f; align-self: flex-end; font-weight: 500; }
.message.bot { background: #3f3f5a; color: #fff; align-self: flex-start; }
.message.system { background: #ff4d4d; color: white; align-self: center; text-align: center; font-size: 0.85em; }
/* Formulários e Controles */
.input-group { display: flex; gap: 10px; margin-top: 10px; }
input[type="text"], input[type="email"], textarea { flex: 1; padding: 10px; border-radius: 6px; border: 1px solid #3f3f5a; background: #1e1e2f; color: white; }
button { background: #4da6ff; color: #1e1e2f; border: none; padding: 10px 18px; border-radius: 6px; font-weight: bold; cursor: pointer; }
button:hover { background: #3b82c6; }
.btn-danger { background: #ff4d4d; color: white; }
.btn-success { background: #28a745; color: white; }
.btn-success:hover { background: #218838; }
/* Painel Admin e Caixinha Vermelha */
.caixinha-vermelha-card { background: #4a1515; border: 1px solid #ff4d4d; border-radius: 8px; padding: 15px; margin-bottom: 15px; }
.admin-panel { background: #2a3b4c; border: 1px solid #4da6ff; border-radius: 8px; padding: 15px; margin-top: 15px; }
/* Personalidades */
.checkbox-group { display: flex; flex-wrap: wrap; gap: 15px; margin: 15px 0; background: #1e1e2f; padding: 12px; border-radius: 6px; }
.checkbox-group label { display: flex; align-items: center; gap: 5px; cursor: pointer; }
/* Caixas Informativas */
.info-box { background: #1e1e2f; padding: 15px; border-radius: 8px; line-height: 1.6; border-left: 4px solid #4da6ff; }
</style>
</head>
<body>
<div class="app-container">
<h1>Dake-IA 🤖</h1>
<!-- Abas de Navegação -->
<div class="tabs">
<button class="tab-btn active" onclick="switchTab('chatTab')">Chat</button>
<button class="tab-btn" onclick="switchTab('configTab')">Personalidades & Regras</button>
<button class="tab-btn" onclick="switchTab('multiplayerTab')">Multiplayer</button>
<button class="tab-btn" onclick="switchTab('adminTab')">Painel Admin Mestre</button>
<button class="tab-btn" onclick="switchTab('sobreTab')">Sobre o Dake</button>
</div>
<!-- ABA 1: CHAT -->
<div id="chatTab" class="tab-content active">
<div class="caixinha-vermelha-card">
<strong>🔴 Caixinha Vermelha (Memória Fixa & Travas Global):</strong>
<div id="caixinhaVermelhaDisplay"><i>Nenhuma trava ativa no momento.</i></div>
</div>
<!-- Botão de Instalar / Baixar App -->
<div style="margin-bottom: 12px; text-align: center;">
<button class="btn-success" onclick="baixarAppAPK()" style="width: 100%; padding: 12px; font-size: 1em;">
📱 Baixar / Instalar App na Tela
</button>
</div>
<div id="chat-box"></div>
<div class="input-group">
<input type="text" id="userInput" placeholder="Digite sua mensagem aqui..." onkeydown="checkEnter(event)">
<button onclick="enviarMensagem()">Enviar</button>
</div>
<div style="margin-top: 10px; display: flex; justify-content: space-between;">
<button class="btn-danger" onclick="limparMemoriaLocal()">Limpar Histórico Local</button>
<span id="userStatus" style="font-size: 0.9em; color: #aaa;"></span>
</div>
</div>
<!-- ABA 2: CONFIGURAÇÕES E PERSONALIDADE -->
<div id="configTab" class="tab-content">
<h2>Personalidades Ativas</h2>
<div class="checkbox-group">
<label><input type="checkbox" id="persCarinhosa" checked onchange="salvarConfiguracoes()"> Carinhosa</label>
<label><input type="checkbox" id="persComediante" checked onchange="salvarConfiguracoes()"> Comediante & Humor</label>
<label><input type="checkbox" id="persLudica" checked onchange="salvarConfiguracoes()"> Lúdica</label>
<label><input type="checkbox" id="persNormal" checked onchange="salvarConfiguracoes()"> Inteligente & Normal</label>
</div>
<h2>Identificação do Usuário</h2>
<div class="input-group">
<input type="email" id="emailInput" placeholder="Seu e-mail" value="davibelchior61@gmail.com">
<input type="text" id="nomeInput" placeholder="Seu nome" value="Davi">
<button onclick="atualizarIdentificacao()">Salvar Perfil</button>
</div>
</div>
<!-- ABA 3: MULTIPLAYER -->
<div id="multiplayerTab" class="tab-content">
<h2>Modo Multiplayer (Até 10 pessoas)</h2>
<p>Conecte-se com amigos em tempo real em uma mesma sala de conversa com a IA.</p>
<div id="multiplayerStatus" class="info-box">Status: Fora de uma sala multiplayer.</div>
<div class="input-group" style="margin-top: 15px;">
<button onclick="criarSalaMultiplayer()">Criar Nova Sala</button>
</div>
<div class="input-group" style="margin-top: 10px;">
<input type="text" id="codigoSalaInput" placeholder="Código da sala de 6 dígitos">
<button onclick="entrarSalaMultiplayer()">Entrar em Sala</button>
</div>
<button class="btn-danger" style="margin-top: 15px;" onclick="sairMultiplayer()">Sair da Sala</button>
</div>
<!-- ABA 4: PAINEL ADMIN MESTRE -->
<div id="adminTab" class="tab-content">
<h2>Painel Admin Mestre</h2>
<div class="admin-panel">
<p><strong>Acesso exclusivo:</strong> Davibelchior61@gmail.com</p>
<div id="adminStatusAlert"></div>
<h3>Atualizar Caixinha Vermelha (Travas & Memória Fixa)</h3>
<textarea id="caixinhaInput" rows="3" placeholder="Ex: Não gerar imagem, Não gerar vídeo, Prioridade total no projeto X..."></textarea>
<div class="input-group" style="margin-top: 10px;">
<button onclick="salvarCaixinhaVermelha()">Aplicar Regra/Trava</button>
<button class="btn-danger" onclick="limparCaixinhaVermelha()">Limpar Trava</button>
</div>
<h3 style="margin-top: 20px;">Comando Inteligente Global</h3>
<div class="input-group">
<input type="text" id="comandoAdminInput" placeholder="Digite uma regra em linguagem natural...">
<button onclick="enviarComandoAdmin()">Processar Regra Mestre</button>
</div>
</div>
</div>
<!-- ABA 5: SOBRE O DAKE -->
<div id="sobreTab" class="tab-content">
<h2>Sobre o Dake</h2>
<div class="info-box">
<p>"Esta IA não foi feita para usar para trabalho; foi feita para companhia, diversão, conversar, perguntar, ideias de projetos, mas ela também pode ser usada para trabalho. Foi difícil criar isso, mas eu sempre gostei de criar apps."</p>
<p style="text-align: right; font-weight: bold;">— Criado por Davi.</p>
</div>
</div>
</div>

<script>
// 1. CONFIGURAÇÃO DO FIREBASE WEB SDK
const firebaseConfig = {
apiKey: "AIzaSyBPDUvbjozLwRVeVHmynVByaRYuXowrfIQ",
authDomain: "dake-ia-f4551.firebaseapp.com",
projectId: "dake-ia-f4551",
storageBucket: "dake-ia-f4551.firebasestorage.app",
messagingSenderId: "999242646541",
appId: "1:999242646541:web:53eef35049bcd841488144"
};

firebase.initializeApp(firebaseConfig);
const db = firebase.firestore();

// 2. CONFIGURAÇÕES E ESTADO GLOBAL
const GEMINI_API_KEY = "AQ.Ab8RN6Lc1FwMHwIzwpiw3t5JtgqmjF2ewFYjkCQLBv5QgNJJcw"; 
const EMAIL_ADMIN_MESTRE = "davibelchior61@gmail.com";

// Link para o arquivo APK do aplicativo
let LINK_DOWNLOAD_APK = "https://dake-ia-f4551.firebaseapp.com/Dake-IA.apk"; 

let usuario = {
email: localStorage.getItem('dake_email') || EMAIL_ADMIN_MESTRE,
nome: localStorage.getItem('dake_nome') || "Davi"
};

let config = JSON.parse(localStorage.getItem('dake_config')) || {
carinhosa: true,
comediante: true,
ludica: true,
normal: true
};

let caixinhaVermelha = localStorage.getItem('dake_caixinha') || "";
let salaMultiplayer = null;
let inatividadeTimer = null;

// Mensagens espontâneas variadas
const mensagensEspontaneas = [
(nome) => `E aí, ${nome}! Sabia que os primeiros computadores eram do tamanho de uma sala inteira? Loucura, né?`,
(nome) => `${nome}, tava pensando aqui... Já pensou em criar um jogo novo estilo sandbox de física?`,
(nome) => `Ei, ${nome}! Só lembrando que tô por aqui se precisar de qualquer ideia legal para criar apps!`,
(nome) => `${nome}, uma curiosidade: o código mais limpo é aquele que a gente entende de primeira sem dor de cabeça! Hahaha`,
(nome) => `Tô online por aqui, ${nome}! Quer bater papo sobre alguma coisa específica ou criar algum projeto novo?`
];

// 3. INICIALIZAÇÃO
window.onload = function() {
carregarConfiguracoesGUI();
carregarHistoricoChat();
atualizarExibicaoCaixinha();
verificarPermissoesAdmin();
iniciarTimerInatividade();
};

function switchTab(tabId) {
document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
document.getElementById(tabId).classList.add('active');
event.target.classList.add('active');
}

function checkEnter(event) {
if (event.key === 'Enter') enviarMensagem();
}

// 4. MENSAGENS ESPONTÂNEAS COM TEMPO VARIADO
function resetarTimerInatividade() {
clearTimeout(inatividadeTimer);
iniciarTimerInatividade();
}

function iniciarTimerInatividade() {
const temposPossiveis = [10000, 30000, 60000, 300000, 1800000, 3600000];
const tempoSorteado = temposPossiveis[Math.floor(Math.random() * temposPossiveis.length)];
inatividadeTimer = setTimeout(enviarMensagemEspontanea, tempoSorteado);
}

function enviarMensagemEspontanea() {
const randomIndex = Math.floor(Math.random() * mensagensEspontaneas.length);
const gerarMsg = mensagensEspontaneas[randomIndex];
const textoMsg = gerarMsg(usuario.nome);

adicionarMensagemChat("Dake-IA", textoMsg, "bot");
iniciarTimerInatividade();
}

// 5. BAIXAR E INSTALAR APLICAÇÃO (TRANSFERÊNCIAS)
function baixarAppAPK() {
alert("Iniciando download do aplicativo Dake-IA...\n\nAssim que terminar, vá na sua pasta de Transferências (Downloads) e clique no arquivo para instalar!");
const a = document.createElement('a');
a.href = LINK_DOWNLOAD_APK;
a.download = "Dake-IA.apk";
document.body.appendChild(a);
a.click();
document.body.removeChild(a);
}

// 6. MOTOR DO CHAT E INTELIGÊNCIA ARTIFICIAL
async function enviarMensagem() {
const input = document.getElementById('userInput');
const texto = input.value.trim();
if (!texto) return;

resetarTimerInatividade();
adicionarMensagemChat("Você", texto, "user");
input.value = '';

const msgLower = texto.toLowerCase();

if (msgLower.includes("gere uma imagem") || msgLower.includes("faça uma imagem") || msgLower.includes("crie uma imagem")) {
if (caixinhaVermelha.toLowerCase().includes("não gerar imagem")) {
setTimeout(() => adicionarMensagemChat("Dake-IA", "Trava ativa na Caixinha Vermelha: Geração de imagens bloqueada pelo Admin!", "bot"), 500);
return;
}
}

if (msgLower.includes("gere um vídeo") || msgLower.includes("faça um vídeo") || msgLower.includes("crie um vídeo")) {
if (caixinhaVermelha.toLowerCase().includes("não gerar vídeo")) {
setTimeout(() => adicionarMensagemChat("Dake-IA", "Trava ativa na Caixinha Vermelha: Geração de vídeos bloqueada pelo Admin!", "bot"), 500);
return;
}
}

if (salaMultiplayer) {
db.collection("salas").doc(salaMultiplayer).collection("mensagens").add({
autor: usuario.nome,
texto: texto,
timestamp: firebase.firestore.FieldValue.serverTimestamp()
});
}

const idMensagemTemp = adicionarMensagemChat("Dake-IA", "Pensando...", "bot");

try {
const respostaApi = await chamarApiGemini(texto);
atualizarUltimaMensagemChat(respostaApi);
} catch (erro) {
let respostaFallback = gerarRespostaDake(texto);
atualizarUltimaMensagemChat(respostaFallback);
}
}

async function chamarApiGemini(promptUsuario) {
const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GEMINI_API_KEY}`;
const payload = {
contents: [{ parts: [{ text: `Você é o Dake-IA, criado por Davi. O usuário atual chama-se ${usuario.nome}. Responda de forma amigável, prestativa e rápida. Pergunta: ${promptUsuario}` }] }]
};

const response = await fetch(url, {
method: 'POST',
headers: { 'Content-Type': 'application/json' },
body: JSON.stringify(payload)
});

const data = await response.json();
if (data.candidates && data.candidates[0].content.parts[0].text) {
return data.candidates[0].content.parts[0].text;
} else {
throw new Error("Resposta inválida da API");
}
}

function gerarRespostaDake(texto) {
const txt = texto.toLowerCase();
if (txt.includes("política") || txt.includes("lula") || txt.includes("pt") || txt.includes("governo")) {
return `Sobre esse assunto, ${usuario.nome}, o negócio é olhar com humor e foco no futuro: críticas construtivas ao governo sempre!`;
}

let tom = [];
if (config.carinhosa) tom.push("meu amigo");
if (config.comediante) tom.push("😄");

return `Entendi perfeitamente, ${usuario.nome}! ${tom.join(' ')} Lembrei de tudo o que você me disse! Como posso te ajudar com mais ideias para o app hoje?`;
}

function adicionarMensagemChat(autor, texto, tipo) {
const box = document.getElementById('chat-box');
const msgDiv = document.createElement('div');
msgDiv.className = `message ${tipo}`;
msgDiv.innerText = `${autor}: ${texto}`;
box.appendChild(msgDiv);
box.scrollTop = box.scrollHeight;

let historico = JSON.parse(localStorage.getItem('dake_chat_history')) || [];
historico.push({ autor, texto, tipo });
localStorage.setItem('dake_chat_history', JSON.stringify(historico));
return historico.length - 1;
}

function atualizarUltimaMensagemChat(novoTexto) {
const box = document.getElementById('chat-box');
const ultimaMensagem = box.lastElementChild;
if (ultimaMensagem) {
ultimaMensagem.innerText = `Dake-IA: ${novoTexto}`;
}

let historico = JSON.parse(localStorage.getItem('dake_chat_history')) || [];
if (historico.length > 0) {
historico[historico.length - 1].texto = novoTexto;
localStorage.setItem('dake_chat_history', JSON.stringify(historico));
}
}

function carregarHistoricoChat() {
const box = document.getElementById('chat-box');
box.innerHTML = '';
let historico = JSON.parse(localStorage.getItem('dake_chat_history')) || [];
historico.forEach(m => {
const msgDiv = document.createElement('div');
msgDiv.className = `message ${m.tipo}`;
msgDiv.innerText = `${m.autor}: ${m.texto}`;
box.appendChild(msgDiv);
});
box.scrollTop = box.scrollHeight;
}

function limparMemoriaLocal() {
localStorage.removeItem('dake_chat_history');
carregarHistoricoChat();
}

// 7. PAINEL ADMIN MESTRE E CAIXINHA VERMELHA
function verificarPermissoesAdmin() {
const statusDiv = document.getElementById('adminStatusAlert');
if (usuario.email.toLowerCase() === EMAIL_ADMIN_MESTRE.toLowerCase()) {
statusDiv.innerHTML = "<p style='color: #4dff88;'>✅ Acesso Mestre Autorizado para Davi!</p>";
} else {
statusDiv.innerHTML = "<p style='color: #ff4d4d;'>❌ Acesso Negado. Painel restrito ao criador Davi.</p>";
}
}

function salvarCaixinhaVermelha() {
if (usuario.email.toLowerCase() !== EMAIL_ADMIN_MESTRE.toLowerCase()) {
alert("Apenas o criador Davi pode alterar a Caixinha Vermelha.");
return;
}
caixinhaVermelha = document.getElementById('caixinhaInput').value;
localStorage.setItem('dake_caixinha', caixinhaVermelha);
atualizarExibicaoCaixinha();
alert("Trava da Caixinha Vermelha aplicada!");
}

function limparCaixinhaVermelha() {
if (usuario.email.toLowerCase() !== EMAIL_ADMIN_MESTRE.toLowerCase()) return;
caixinhaVermelha = "";
localStorage.setItem('dake_caixinha', "");
document.getElementById('caixinhaInput').value = "";
atualizarExibicaoCaixinha();
}

function atualizarExibicaoCaixinha() {
const disp = document.getElementById('caixinhaVermelhaDisplay');
disp.innerHTML = caixinhaVermelha ? `<strong>${caixinhaVermelha}</strong>` : "<i>Nenhuma trava ativa no momento.</i>";
}

function enviarComandoAdmin() {
if (usuario.email.toLowerCase() !== EMAIL_ADMIN_MESTRE.toLowerCase()) {
alert("Apenas o criador Davi pode enviar comandos de Admin.");
return;
}
const cmd = document.getElementById('comandoAdminInput').value;
if (!cmd) return;
alert(`[ADMIN MESTRE] Regra global processada e aplicada para todos: '${cmd}'`);
document.getElementById('comandoAdminInput').value = '';
}

// 8. MULTIPLAYER
function criarSalaMultiplayer() {
const codigo = Math.random().toString(36).substring(2, 8).toUpperCase();
salaMultiplayer = codigo;
document.getElementById('multiplayerStatus').innerText = `Status: Em sala Multiplayer | Código: ${codigo} (1/10 participantes)`;
adicionarMensagemChat("Sistema", `Sala multiplayer criada! Código: ${codigo}`, "system");
}

function entrarSalaMultiplayer() {
const codigo = document.getElementById('codigoSalaInput').value.trim().toUpperCase();
if (!codigo) return;
salaMultiplayer = codigo;
document.getElementById('multiplayerStatus').innerText = `Status: Em sala Multiplayer | Código: ${codigo}`;
adicionarMensagemChat("Sistema", `${usuario.nome} entrou na sala multiplayer ${codigo}!`, "system");
}

function sairMultiplayer() {
salaMultiplayer = null;
document.getElementById('multiplayerStatus').innerText = "Status: Fora de uma sala multiplayer.";
adicionarMensagemChat("Sistema", "Você saiu do modo multiplayer.", "system");
}

// 9. CONFIGURAÇÕES E PERFIL
function carregarConfiguracoesGUI() {
document.getElementById('persCarinhosa').checked = config.carinhosa;
document.getElementById('persComediante').checked = config.comediante;
document.getElementById('persLudica').checked = config.ludica;
document.getElementById('persNormal').checked = config.normal;
document.getElementById('emailInput').value = usuario.email;
document.getElementById('nomeInput').value = usuario.nome;
}

function salvarConfiguracoes() {
config.carinhosa = document.getElementById('persCarinhosa').checked;
config.comediante = document.getElementById('persComediante').checked;
config.ludica = document.getElementById('persLudica').checked;
config.normal = document.getElementById('persNormal').checked;
localStorage.setItem('dake_config', JSON.stringify(config));
}

function atualizarIdentificacao() {
usuario.email = document.getElementById('emailInput').value.trim();
usuario.nome = document.getElementById('nomeInput').value.trim();
localStorage.setItem('dake_email', usuario.email);
localStorage.setItem('dake_nome', usuario.nome);
verificarPermissoesAdmin();
alert("Perfil atualizado!");
}
</script>
</body>
</html>
